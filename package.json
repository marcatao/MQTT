{
  "name": "mqtt-client",
  "version": "1.0.0",
  "description": "Cliente MQTT em Node.js: publisher e subscriber com mqtt.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "broker": "node --env-file-if-exists=.env src/broker.js",
    "sub": "node --env-file-if-exists=.env src/subscriber.js",
    "pub": "node --env-file-if-exists=.env src/publisher.js"
  },
  "license": "MIT",
  "dependencies": {
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "aedes": "^1.2.0"
  }
}
